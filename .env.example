# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Signs login sessions. Make one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Google sign-in and Gmail (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Groq keys for the AI step: one line, separated by commas, no spaces
GROQ_API_KEYS=

# Gmail account that sends password-reset mails, and its 16-letter app password
MAIL_USERNAME=
MAIL_APP_PASSWORD=

# Optional: full web address of the site, used in reset links (for example https://joblens.example.com)
APP_BASE_URL=
